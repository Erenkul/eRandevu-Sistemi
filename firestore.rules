rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(businessId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    // --- BÖLÜM 0: KULLANICILAR (Users) ---
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // --- BÖLÜM 1: İŞLETMELER, HİZMETLER VE PERSONELLER ---
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(businessId);
    }
    
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(request.resource.data.businessId);
      allow update, delete: if isOwner(resource.data.businessId);
    }
    
    match /staff/{staffId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(request.resource.data.businessId);
      allow update, delete: if isOwner(resource.data.businessId);
    }

    // --- BÖLÜM 2: RANDEVU MANTIĞI & GÖLGE DOKÜMANLAR ---
    
    match /daily_schedules/{scheduleId} {
      allow read: if true;
      
      allow create, update: if
        request.resource.data.keys().hasAll(['businessId', 'staffId', 'date', 'appointments']) && 
        request.resource.data.businessId is string &&
        request.resource.data.staffId is string &&
        request.resource.data.appointments is list;
        
      allow delete: if isAuthenticated() && isOwner(resource.data.businessId);
    }

    // Asıl Randevular (appointments)
    match /appointments/{appointmentId} {
      // Admin panel lists appointments — authenticated users only
      // Multi-tenant isolation is enforced by query filters (where businessId == user's businessId)
      allow list: if isAuthenticated();

      // Public read needed for transaction conflict checks in createAppointment
      // Appointment IDs are Firestore auto-generated (20+ random chars), not guessable
      allow get: if true;
      
      // Public booking flow — no auth required, but must have required fields
      allow create: if 
        request.resource.data.keys().hasAll(['businessId', 'staffId', 'customerName', 'customerPhone', 'dateTime', 'services', 'status']) &&
        request.resource.data.status == 'pending';
      
      allow update, delete: if isAuthenticated() && (
        isOwner(resource.data.businessId)
      );
    }

    // --- BÖLÜM 3: MÜŞTERİLER (Customers) ---
    match /customers/{customerId} {
      allow read, update, delete: if isOwner(resource.data.businessId);
      
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['businessId', 'name', 'phone']) &&
        isOwner(request.resource.data.businessId);
    }
  }
}
