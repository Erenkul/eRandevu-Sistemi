# Test için sahte Firebase ayarları: hiçbiri gerçek değil, hiçbir yere bağlanmaz.
# Testler (vitest, mode=test) bunu okur; gerçek değerler frontend/.env.local'da durur ve depoya girmez.
VITE_FIREBASE_API_KEY=test-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-erandevu.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-erandevu
VITE_FIREBASE_STORAGE_BUCKET=demo-erandevu.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-TEST
VITE_USE_EMULATORS=false
VITE_APP_NAME=eRandevu
VITE_APP_URL=http://localhost:5173
